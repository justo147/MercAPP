<?xml version="1.0" encoding="UTF-8" ?>
<phpdocumentor
    configVersion="3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://www.phpdoc.org"
    xsi:noNamespaceSchemaLocation="https://docs.phpdoc.org/latest/phpdoc.xsd">

    <title>MercApp - Documentación</title>

    <paths>
        <output>docs/php</output>
        <cache>docs/.cache</cache>
    </paths>

    <version number="1.0.0">
        <api>
            <source dsn=".">
                <path>controllers/</path>
                <path>models/</path>
                <path>config/</path>
                <path>public/</path>
                <path>test/</path>
            </source>

            <ignore hidden="true">
                <path>vendor/*</path>
                <path>docs/*</path>
            </ignore>
        </api>
    </version>

</phpdocumentor>