{% extends 'base_auth.html.twig' %}
{% block title %}Recuperar contraseña — MercApp{% endblock %}
{% block content %}
<div class="auth-card fade-in show">
  <div class="text-center mb-4">
    <div style="width:64px;height:64px;border-radius:50%;background:var(--c-primary-light);
                display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;">
      <i class="bi bi-key" style="font-size:1.75rem;color:var(--c-primary);"></i>
    </div>
    <h1 class="auth-title">Recuperar contraseña</h1>
    <p class="auth-subtitle">Te enviamos un enlace a tu correo</p>
  </div>

  {% if mensaje %}
  <div class="alert alert-info d-flex align-items-center gap-2 mb-3 py-2" role="alert">
    <i class="bi bi-info-circle-fill flex-shrink-0"></i>
    <span style="font-size:.88rem;">{{ mensaje }}</span>
  </div>
  {% endif %}

  <form method="post">
    <div class="mb-3">
      <label for="email" class="form-label">Correo electrónico</label>
      <input type="email" id="email" name="email" class="form-control"
             placeholder="tu@correo.com" required>
    </div>
    <button type="submit" class="btn btn-primary w-100 btn-lg">
      Enviar enlace de recuperación
    </button>
  </form>

  <p class="text-center mt-4 mb-0" style="font-size:.88rem;color:var(--c-muted);">
    <a href="{{ BASE }}/public/views/auth/login.php">
      <i class="bi bi-arrow-left me-1"></i>Volver al login
    </a>
  </p>
</div>
{% endblock %}
