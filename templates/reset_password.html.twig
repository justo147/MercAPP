{% extends 'base_auth.html.twig' %}
{% block title %}Nueva contraseña — MercApp{% endblock %}
{% block content %}
<div class="auth-card fade-in show">
  <div class="text-center mb-4">
    <div style="width:64px;height:64px;border-radius:50%;background:var(--c-primary-light);
                display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;">
      <i class="bi bi-lock" style="font-size:1.75rem;color:var(--c-primary);"></i>
    </div>
    <h1 class="auth-title">Nueva contraseña</h1>
    <p class="auth-subtitle">Elige una contraseña segura</p>
  </div>

  {% if message %}
  <div class="alert alert-info d-flex align-items-center gap-2 mb-3 py-2">
    <i class="bi bi-info-circle-fill flex-shrink-0"></i>
    <span style="font-size:.88rem;">{{ message }}</span>
  </div>
  {% endif %}

  <form method="post">
    <input type="hidden" name="token" value="{{ token ?? '' }}">
    <div class="mb-3">
      <label for="password" class="form-label">Nueva contraseña</label>
      <div class="input-group">
        <input type="password" id="password" name="password" class="form-control"
               placeholder="Mínimo 8 caracteres" required>
        <button type="button" class="btn btn-outline-secondary" id="toggle-pass"
                aria-label="Mostrar contraseña" tabindex="-1">
          <i class="bi bi-eye" id="icon-pass"></i>
        </button>
      </div>
    </div>
    <button type="submit" class="btn btn-primary w-100 btn-lg">
      Actualizar contraseña
    </button>
  </form>
</div>
{% endblock %}

{% block scripts %}
<script>
document.getElementById('toggle-pass')?.addEventListener('click', function(){
  const inp = document.getElementById('password');
  const ico = document.getElementById('icon-pass');
  if (inp.type === 'password') { inp.type = 'text'; ico.className = 'bi bi-eye-slash'; }
  else { inp.type = 'password'; ico.className = 'bi bi-eye'; }
});
</script>
{% endblock %}
