{% extends 'base_auth.html.twig' %}
{% block title %}Nueva contraseña — MercApp{% endblock %}

{% block head_extra %}
<style>
.req-item { color: var(--c-muted); transition: color .2s; font-size:.78rem; }
.req-item.ok { color: #198754; }
.req-item.ok i::before { content: "\f26a"; }
</style>
{% endblock %}

{% block content %}
<div class="auth-card fade-in show">
  <div class="text-center mb-4">
    <div style="width:64px;height:64px;border-radius:50%;background:var(--c-primary-light);
                display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;">
      <i class="bi bi-lock" style="font-size:1.75rem;color:var(--c-primary);"></i>
    </div>
    <h1 class="auth-title">Nueva contraseña</h1>
    <p class="auth-subtitle">Elige una contraseña segura</p>
  </div>

  {% if message %}
    {{ message|raw }}
  {% endif %}

  {% if not success %}
  <form method="post" id="form-reset">
    <input type="hidden" name="token" value="{{ token ?? '' }}">

    <div class="mb-2">
      <label for="password" class="form-label">Nueva contraseña</label>
      <div class="input-group">
        <input type="password" id="password" name="password" class="form-control"
               placeholder="Mínimo 8 caracteres" required>
        <button type="button" class="btn btn-outline-secondary" id="toggle-pass"
                aria-label="Mostrar contraseña" tabindex="-1">
          <i class="bi bi-eye" id="icon-pass"></i>
        </button>
      </div>

      <div class="mt-2" id="strength-wrap" style="display:none;">
        <div class="d-flex gap-1 mb-1">
          <div id="seg-1" class="flex-fill rounded-pill" style="height:5px;background:var(--c-border);transition:background .25s;"></div>
          <div id="seg-2" class="flex-fill rounded-pill" style="height:5px;background:var(--c-border);transition:background .25s;"></div>
          <div id="seg-3" class="flex-fill rounded-pill" style="height:5px;background:var(--c-border);transition:background .25s;"></div>
          <div id="seg-4" class="flex-fill rounded-pill" style="height:5px;background:var(--c-border);transition:background .25s;"></div>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-2">
          <small id="strength-label" class="fw-semibold" style="font-size:.78rem;"></small>
          <small id="strength-tip"   class="text-muted"  style="font-size:.75rem;"></small>
        </div>
        <ul class="list-unstyled mb-0">
          <li id="req-len" class="req-item"><i class="bi bi-x-circle-fill me-1"></i>Mínimo 8 caracteres</li>
          <li id="req-upp" class="req-item"><i class="bi bi-x-circle-fill me-1"></i>Una letra mayúscula</li>
          <li id="req-num" class="req-item"><i class="bi bi-x-circle-fill me-1"></i>Un número</li>
          <li id="req-sym" class="req-item"><i class="bi bi-x-circle-fill me-1"></i>Un símbolo (!@#…)</li>
        </ul>
      </div>
    </div>

    <button type="submit" class="btn btn-primary w-100 btn-lg mt-3" id="btn-submit">
      Actualizar contraseña
    </button>
  </form>
  {% endif %}
</div>
{% endblock %}

{% block scripts %}
<script>
/* ── Toggle visibilidad ── */
document.getElementById('toggle-pass')?.addEventListener('click', function () {
  const inp = document.getElementById('password');
  const ico = document.getElementById('icon-pass');
  if (inp.type === 'password') { inp.type = 'text';     ico.className = 'bi bi-eye-slash'; }
  else                         { inp.type = 'password'; ico.className = 'bi bi-eye';       }
});

/* ── Medidor de fuerza (igual que en registro) ── */
const CRITERIOS = [
  { id: 'req-len', test: p => p.length >= 8           },
  { id: 'req-upp', test: p => /[A-Z]/.test(p)         },
  { id: 'req-num', test: p => /[0-9]/.test(p)         },
  { id: 'req-sym', test: p => /[^A-Za-z0-9]/.test(p) },
];
const NIVELES = [
  { color: '#dc3545', label: 'Muy débil',  tip: 'Añade mayúsculas y números'    },
  { color: '#fd7e14', label: 'Débil',      tip: 'Añade un símbolo (!@#…)'       },
  { color: '#ffc107', label: 'Regular',    tip: 'Casi bien, añade más variedad' },
  { color: '#20c997', label: 'Fuerte',     tip: '¡Buena contraseña!'            },
  { color: '#198754', label: 'Muy fuerte', tip: 'Contraseña excelente'          },
];

function evaluarPassword(pwd) {
  const checks   = CRITERIOS.map(c => c.test(pwd));
  const cumplidos = checks.filter(Boolean).length;
  const bonus    = pwd.length >= 12 ? 1 : 0;
  return { checks, score: Math.max(Math.min(cumplidos + bonus - 1, 4), 0), cumplidos };
}

const passInput = document.getElementById('password');
const btnSubmit = document.getElementById('btn-submit');

passInput?.addEventListener('input', () => {
  const pwd  = passInput.value;
  const wrap = document.getElementById('strength-wrap');
  if (!wrap) return;

  if (!pwd) { wrap.style.display = 'none'; btnSubmit.disabled = false; return; }
  wrap.style.display = 'block';

  const { checks, score, cumplidos } = evaluarPassword(pwd);
  const activos = cumplidos === 0 ? 1 : cumplidos;
  const color   = NIVELES[score].color;

  [1,2,3,4].forEach(n => {
    const seg = document.getElementById('seg-' + n);
    seg.style.background = n <= activos ? color : 'var(--c-border)';
  });

  document.getElementById('strength-label').textContent = NIVELES[score].label;
  document.getElementById('strength-label').style.color = color;
  document.getElementById('strength-tip').textContent   = NIVELES[score].tip;

  CRITERIOS.forEach((c, i) => {
    document.getElementById(c.id)?.classList.toggle('ok', checks[i]);
  });

  btnSubmit.disabled = cumplidos < CRITERIOS.length;
});

/* ── Bloquear submit si no cumple requisitos ── */
document.getElementById('form-reset')?.addEventListener('submit', function (e) {
  if (!passInput.value) return;
  const { cumplidos } = evaluarPassword(passInput.value);
  if (cumplidos < CRITERIOS.length) {
    e.preventDefault();
    passInput.focus();
  }
});
</script>
{% endblock %}
