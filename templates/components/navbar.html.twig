<nav class="app-navbar" aria-label="Navegación principal">
  <div class="navbar-inner">

    <!-- Brand -->
    <a href="{{ BASE }}/home" class="brand">
      <img src="{{ asset('img/logo_sinfondo.png') }}" alt="MercApp">
      MercApp
    </a>

    <!-- Search (desktop) -->
    <div class="search-wrap d-none d-md-block">
      <form class="search-form" id="navbar-search-form" method="get" action="{{ BASE }}/home" data-no-loading>
        <input type="search" id="navbar-search" name="q" placeholder="Buscar productos, categorías…"
               value="{{ app_query is defined ? app_query : '' }}"
               autocomplete="off" aria-label="Buscar productos">
        <button type="submit" aria-label="Buscar"><i class="bi bi-search"></i></button>
      </form>
    </div>

    <!-- Actions -->
    <div class="nav-actions ms-auto ms-md-0">

      {% if session.user_id %}

      <!-- Notifications -->
      <div class="dropdown">
        <button class="nav-icon-btn" id="notif-btn" data-bs-toggle="dropdown"
                aria-label="Notificaciones" aria-expanded="false">
          <i class="bi bi-bell"></i>
          <span id="badge-notif" class="badge-count"></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end p-1" id="notif-lista"
            style="min-width:300px;max-height:360px;overflow-y:auto;">
          <li class="px-3 py-2 text-muted small" id="notif-vacio">Sin notificaciones nuevas</li>
        </ul>
      </div>

      <!-- Favorites -->
      <a href="{{ BASE }}/favorites"
         class="nav-icon-btn" title="Favoritos" aria-label="Mis favoritos">
        <i class="bi bi-heart"></i>
      </a>

      <!-- Messages -->
      <a href="{{ BASE }}/chat"
         class="nav-icon-btn position-relative" title="Mensajes" aria-label="Mensajes">
        <i class="bi bi-chat"></i>
        <span id="badge-mensajes" class="badge-count"></span>
      </a>

      <!-- User dropdown -->
      <div class="dropdown">
        <button class="app-dropdown-toggle" id="userMenu" data-bs-toggle="dropdown"
                aria-label="Menú de usuario" aria-expanded="false">
          {% if session.profile_photo %}
            <img src="{{ BASE }}/{{ session.profile_photo|e }}" class="nav-avatar" alt="Foto de perfil">
          {% else %}
            <span class="nav-avatar-placeholder"><i class="bi bi-person"></i></span>
          {% endif %}
          <i class="bi bi-chevron-down" style="font-size:.7rem;color:var(--c-muted);"></i>
        </button>

        <ul class="dropdown-menu dropdown-menu-end">
          {% if session.role == 'admin' %}
          <li>
            <a class="dropdown-item fw-semibold" href="{{ BASE }}/admin">
              <i class="bi bi-shield-lock text-primary"></i> Panel Admin
            </a>
          </li>
          <li><hr class="dropdown-divider"></li>
          {% endif %}

          <li>
            <a class="dropdown-item" href="{{ BASE }}/profile/{{ session.user_id }}">
              <i class="bi bi-person-circle"></i> Mi perfil
            </a>
          </li>
          <li>
            <a class="dropdown-item" href="{{ BASE }}/chat">
              <i class="bi bi-envelope"></i> Mensajes
            </a>
          </li>
          <li>
            <a class="dropdown-item" href="{{ BASE }}/transactions">
              <i class="bi bi-clock-history"></i> Mis transacciones
            </a>
          </li>
          <li>
            <a class="dropdown-item" href="{{ BASE }}/product/upload">
              <i class="bi bi-plus-circle"></i> Subir producto
            </a>
          </li>
          <li>
            <a class="dropdown-item" href="{{ BASE }}/wishlist">
              <i class="bi bi-stars"></i> Lista de deseos
            </a>
          </li>
          <li>
            <a class="dropdown-item" href="{{ BASE }}/following">
              <i class="bi bi-people"></i> Siguiendo
            </a>
          </li>
          <li><hr class="dropdown-divider"></li>
          <li>
            <a class="dropdown-item" href="{{ BASE }}/account">
              <i class="bi bi-gear"></i> Ajustes de cuenta
            </a>
          </li>
          <li>
            <a class="dropdown-item" href="{{ BASE }}/help">
              <i class="bi bi-question-circle"></i> Ayuda
            </a>
          </li>
          <li><hr class="dropdown-divider"></li>
          <li>
            <a class="dropdown-item text-danger" href="{{ BASE }}/logout">
              <i class="bi bi-box-arrow-right"></i> Cerrar sesión
            </a>
          </li>
        </ul>
      </div>

      {% else %}

      <!-- Guest: Login + Register -->
      <a href="{{ BASE }}/login" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión
      </a>
      <a href="{{ BASE }}/register" class="btn btn-primary btn-sm">
        <i class="bi bi-person-plus me-1"></i>Registrarse
      </a>

      {% endif %}

      <!-- Theme toggle -->
      <button id="themeToggle" class="theme-toggle" aria-label="Cambiar tema" title="Cambiar tema">
        <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
      </button>

      <!-- Mobile search toggle -->
      <button class="navbar-mobile-toggle d-md-none" id="mobileSearchToggle" aria-label="Buscar">
        <i class="bi bi-search"></i>
      </button>
    </div>

  </div>

  <!-- Mobile search bar -->
  <div class="search-wrap d-md-none" id="mobileSearch">
    <form class="search-form" id="navbar-search-form-mobile" method="get" action="{{ BASE }}/home" data-no-loading>
      <input type="search" id="navbar-search-mobile" name="q" placeholder="Buscar productos…"
             value="{{ app_query is defined ? app_query : '' }}" autocomplete="off">
      <button type="submit"><i class="bi bi-search"></i></button>
    </form>
  </div>
</nav>
