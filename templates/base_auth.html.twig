<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}MercApp{% endblock %}</title>

  <link rel="icon" href="{{ asset('ico/logo_sinfondo.ico') }}" type="image/x-icon">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

  <!-- Design system -->
  <link rel="stylesheet" href="{{ asset('css/app.css') }}">

  {% block head_extra %}{% endblock %}

  <script>
    (function(){
      var t = localStorage.getItem('mercapp_theme') || 'light';
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
</head>
<body class="auth-page">

  <div style="position:fixed;top:1rem;right:1rem;z-index:100;">
    <button id="themeToggle" class="theme-toggle" aria-label="Cambiar tema" title="Cambiar tema">
      <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
    </button>
  </div>

  {% block content %}{% endblock %}

  <!-- Toast container -->
  <div id="toast-container"></div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>const BASE = "{{ BASE }}";</script>
  <script src="{{ asset('js/theme.js') }}"></script>
  <script src="{{ asset('js/ux.js') }}" defer></script>

  {% block scripts %}{% endblock %}

  {{ flash_scripts() }}
</body>
</html>
