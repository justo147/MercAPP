{% extends 'base.html.twig' %}
{% block title %}Novedades — MercApp{% endblock %}

{% block content %}
<div class="row g-4 align-items-start" style="max-width:1200px;margin:0 auto;">

  <!-- Feed -->
  <div class="col-lg-8">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h4 class="fw-bold mb-0"><i class="bi bi-newspaper me-2 text-primary"></i>Novedades</h4>
      <span id="feed-total" class="text-muted small"></span>
    </div>

    <!-- Skeleton -->
    <div id="feed-skeletons" class="row g-3">
      {% for i in 1..8 %}
      <div class="col-6 col-md-4">
        <div class="skeleton" style="height:250px;border-radius:var(--r-lg);"></div>
      </div>
      {% endfor %}
    </div>

    <div id="feed-empty" class="empty-state d-none">
      <i class="bi bi-newspaper"></i>
      <h3>Sin novedades</h3>
      <p>Aquí verás los productos de las personas que sigas.</p>
    </div>

    <div class="row g-3" id="product-list"></div>

    <div class="text-center mt-4 d-none" id="loadmore-wrap">
      <button id="loadMore" class="btn btn-outline-primary px-4">
        <i class="bi bi-arrow-down-circle me-1"></i>Cargar más
      </button>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="col-lg-4">

    <!-- Siguiendo -->
    <div class="card mb-3">
      <div class="card-header d-flex align-items-center justify-content-between py-2">
        <span class="fw-semibold small"><i class="bi bi-person-check-fill me-1 text-primary"></i>Siguiendo</span>
        <span class="badge rounded-pill" style="background:var(--c-primary);">{{ siguiendo|length }}</span>
      </div>
      {% if siguiendo is empty %}
      <div class="card-body text-center py-4">
        <i class="bi bi-person-plus fs-2 d-block mb-2 text-muted opacity-50"></i>
        <p class="small text-muted mb-0">No sigues a nadie todavía.</p>
      </div>
      {% else %}
      <ul class="list-group list-group-flush" id="siguiendo-list">
        {% for u in siguiendo %}
        {% set nombre = (u.nombre ~ ' ' ~ u.apellidos)|trim|e %}
        <li class="list-group-item d-flex align-items-center gap-2 py-2 px-3" id="sgt-{{ u.id }}">
          <a href="{{ BASE }}/public/views/profile.php?id={{ u.id }}" class="flex-shrink-0">
            {% if u.foto_perfil %}
            <img src="{{ BASE }}/{{ u.foto_perfil|e }}" alt="{{ nombre }}"
                 style="width:36px;height:36px;border-radius:50%;object-fit:cover;"
                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
            <span style="display:none;width:36px;height:36px;border-radius:50%;background:var(--c-bg);align-items:center;justify-content:center;">
              <i class="bi bi-person"></i>
            </span>
            {% else %}
            <span style="display:flex;width:36px;height:36px;border-radius:50%;background:var(--c-bg);align-items:center;justify-content:center;">
              <i class="bi bi-person text-muted"></i>
            </span>
            {% endif %}
          </a>
          <div class="flex-grow-1 min-w-0">
            <a href="{{ BASE }}/public/views/profile.php?id={{ u.id }}"
               class="text-body text-decoration-none small fw-semibold text-truncate d-block">{{ nombre }}</a>
          </div>
          <button class="btn btn-sm btn-outline-secondary fw-unfollow-btn flex-shrink-0"
                  data-id="{{ u.id }}" title="Dejar de seguir" style="font-size:.72rem;padding:2px 7px;">
            <i class="bi bi-person-dash"></i>
          </button>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>

    <!-- Sugerencias -->
    {% if sugerencias is not empty %}
    <div class="card" id="sug-card">
      <div class="card-header py-2">
        <span class="fw-semibold small"><i class="bi bi-stars me-1 text-warning"></i>Sugerencias para ti</span>
      </div>
      <div class="card-body p-0">
        {% for s in sugerencias %}
        {% set sNombre = (s.nombre ~ ' ' ~ s.apellidos)|trim|e %}
        <div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom" id="sug-{{ s.id }}">
          <a href="{{ BASE }}/public/views/profile.php?id={{ s.id }}" class="flex-shrink-0">
            {% if s.foto_perfil %}
            <img src="{{ BASE }}/{{ s.foto_perfil|e }}" alt="{{ sNombre }}"
                 style="width:36px;height:36px;border-radius:50%;object-fit:cover;"
                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
            <span style="display:none;width:36px;height:36px;border-radius:50%;background:var(--c-bg);align-items:center;justify-content:center;">
              <i class="bi bi-person"></i>
            </span>
            {% else %}
            <span style="display:flex;width:36px;height:36px;border-radius:50%;background:var(--c-bg);align-items:center;justify-content:center;">
              <i class="bi bi-person text-muted"></i>
            </span>
            {% endif %}
          </a>
          <div class="flex-grow-1 min-w-0">
            <a href="{{ BASE }}/public/views/profile.php?id={{ s.id }}"
               class="text-body text-decoration-none small fw-semibold text-truncate d-block">{{ sNombre }}</a>
            <span class="text-muted" style="font-size:.7rem;">
              <i class="bi bi-box-seam me-1"></i>{{ s.total_productos }} producto{{ s.total_productos != 1 ? 's' : '' }}
            </span>
          </div>
          <button class="btn btn-sm fw-follow-btn flex-shrink-0" data-id="{{ s.id }}"
                  style="background:var(--c-primary);color:#fff;font-size:.72rem;padding:3px 8px;white-space:nowrap;">
            <i class="bi bi-person-plus-fill me-1"></i>Seguir
          </button>
        </div>
        {% endfor %}
      </div>
    </div>
    {% elseif siguiendo is empty %}
    <div class="card text-center p-4">
      <i class="bi bi-people fs-1 d-block mb-2 text-muted opacity-50"></i>
      <p class="small text-muted mb-0">Cuando otros publiquen productos, aparecerán aquí como sugerencias.</p>
    </div>
    {% endif %}

  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
const FW_USER_ID = {{ usuarioId }};
let fwPage = 1, fwLoading = false, fwFirst = true;
const FW_LIMIT = 9;
const DEF = `${BASE}/public/img/default.jpg`;

function esc(s) { const d=document.createElement('div');d.textContent=s??'';return d.innerHTML; }
function badgeTipo(tipo) {
  const m={venta:'primary',intercambio:'warning text-dark',mixto:'success'};
  return `<span class="badge bg-${m[tipo]??'secondary'}" style="font-size:.6rem;">${esc(tipo)}</span>`;
}

function renderProduct(p) {
  const img = p.imagenes?.length ? `${BASE}/${p.imagenes[0].url}` : DEF;
  const precio = p.precio && parseFloat(p.precio)>0 ? `${parseFloat(p.precio).toFixed(2)} €` : 'Gratis';
  const col = document.createElement('div');
  col.className = 'col-6 col-md-4';
  col.innerHTML = `<a href="${BASE}/public/views/detail_product.php?id=${p.id}" class="text-decoration-none">
    <div class="product-card">
      <img src="${img}" alt="${esc(p.titulo)}" style="width:100%;height:170px;object-fit:cover;"
           onerror="this.onerror=null;this.src='${DEF}'">
      <div class="p-3">
        <div class="fw-semibold text-truncate" style="color:var(--c-text);">${esc(p.titulo)}</div>
        <div class="my-1">${badgeTipo(p.tipo_transaccion)}</div>
        <div class="fw-bold" style="color:var(--c-primary);">${precio}</div>
        <div class="small text-muted mt-1"><i class="bi bi-person me-1"></i>${esc(p.usuario_nombre??'')}</div>
      </div>
    </div>
  </a>`;
  return col;
}

function loadProducts() {
  if (fwLoading) return;
  fwLoading = true;
  fetch(`${BASE}/api/products_following.php?page=${fwPage}&limit=${FW_LIMIT}`)
    .then(r => r.json())
    .then(data => {
      const skel  = document.getElementById('feed-skeletons');
      const empty = document.getElementById('feed-empty');
      const list  = document.getElementById('product-list');
      const wrap  = document.getElementById('loadmore-wrap');
      const total = document.getElementById('feed-total');
      if (fwFirst && skel) { skel.remove(); fwFirst = false; }
      if (!data.success || !data.productos.length) {
        if (fwPage===1) empty.classList.remove('d-none');
        wrap.classList.add('d-none');
      } else {
        if (data.total!=null) total.textContent = `${data.total} producto${data.total!==1?'s':''}`;
        data.productos.forEach(p => list.appendChild(renderProduct(p)));
        wrap.classList.toggle('d-none', data.productos.length < FW_LIMIT);
      }
    })
    .catch(() => { document.getElementById('feed-skeletons')?.remove(); fwFirst=false; })
    .finally(() => fwLoading = false);
}

document.getElementById('loadMore').addEventListener('click', () => { fwPage++; loadProducts(); });
loadProducts();

// Follow from suggestions
document.querySelectorAll('.fw-follow-btn').forEach(btn => {
  btn.addEventListener('click', function() {
    const seguido = this.dataset.id; this.disabled=true;
    this.innerHTML='<span class="spinner-border spinner-border-sm"></span>';
    fetch(`${BASE}/controllers/follow.php`,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:`seguidor=${FW_USER_ID}&seguido=${seguido}`})
      .then(r=>r.json()).then(data => { if(data.success) window.location.reload(); else { this.disabled=false; this.innerHTML='<i class="bi bi-person-plus-fill me-1"></i>Seguir'; } })
      .catch(() => { this.disabled=false; this.innerHTML='<i class="bi bi-person-plus-fill me-1"></i>Seguir'; });
  });
});

// Unfollow
document.querySelectorAll('.fw-unfollow-btn').forEach(btn => {
  btn.addEventListener('click', function() {
    const seguido = this.dataset.id;
    if (!confirm('¿Dejar de seguir a este usuario?')) return;
    this.disabled=true;
    fetch(`${BASE}/controllers/unfollow.php`,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:`seguidor=${FW_USER_ID}&seguido=${seguido}`})
      .then(r=>r.json()).then(data => { if(data.success) window.location.reload(); else this.disabled=false; })
      .catch(() => this.disabled=false);
  });
});
</script>
{% endblock %}
