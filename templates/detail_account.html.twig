{% extends 'base.html.twig' %}
{% block title %}Mi cuenta — MercApp{% endblock %}

{% block content %}
<div style="max-width:640px;margin:0 auto;">

  <h4 class="fw-bold mb-4"><i class="bi bi-person-gear me-2 text-primary"></i>Detalles de la cuenta</h4>

  {% if updated %}
  <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>Datos actualizados correctamente.</div>
  {% endif %}
  {% if error %}
  <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>{{ error|e }}</div>
  {% endif %}

  <div class="card">
    <div class="card-body">
      <form method="POST" enctype="multipart/form-data">

        <!-- Foto de perfil -->
        <div class="mb-4 text-center">
          {% if user.foto_perfil %}
          <img src="{{ BASE }}/{{ user.foto_perfil|e }}" alt="Foto de perfil"
               class="rounded-circle mb-3" width="100" height="100"
               style="object-fit:cover;border:3px solid var(--c-primary);"
               onerror="this.style.display='none'">
          {% else %}
          <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3"
               style="width:100px;height:100px;background:var(--c-bg);border:3px solid var(--c-border);">
            <i class="bi bi-person-fill fs-1 text-muted"></i>
          </div>
          {% endif %}
          <div>
            <label for="inputFoto" class="form-label fw-semibold">Cambiar foto de perfil</label>
            <input type="file" id="inputFoto" name="foto" class="form-control" accept="image/*">
          </div>
        </div>

        <div class="row g-3">
          <div class="col-md-6">
            <label for="inputNombre" class="form-label fw-semibold">Nombre</label>
            <input type="text" id="inputNombre" name="nombre" class="form-control"
                   value="{{ user.nombre|e }}" required>
          </div>
          <div class="col-md-6">
            <label for="inputApellidos" class="form-label fw-semibold">Apellidos</label>
            <input type="text" id="inputApellidos" name="apellidos" class="form-control"
                   value="{{ user.apellidos|default('')|e }}">
          </div>
          <div class="col-12">
            <label for="inputEmail" class="form-label fw-semibold">Correo electrónico</label>
            <input type="email" id="inputEmail" name="email" class="form-control"
                   value="{{ user.email|e }}" required>
          </div>
          <div class="col-12">
            <label for="inputTelefono" class="form-label fw-semibold">Teléfono</label>
            <input type="text" id="inputTelefono" name="telefono" class="form-control"
                   value="{{ user.telefono|default('')|e }}">
          </div>
        </div>

        <div class="d-grid mt-4">
          <button type="submit" class="btn btn-success">
            <i class="bi bi-check-lg me-1"></i>Guardar cambios
          </button>
        </div>
      </form>
    </div>
  </div>

</div>
{% endblock %}
