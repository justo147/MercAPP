{% extends 'base.html.twig' %}
{% block title %}Mis favoritos — MercApp{% endblock %}

{% block content %}
<div style="max-width:960px;margin:0 auto;">

  <h4 class="fw-bold mb-4">
    <i class="bi bi-heart me-2 text-danger"></i>Mis favoritos
  </h4>

  {% if favoritos is empty %}
  <div class="empty-state">
    <i class="bi bi-heart"></i>
    <h3>Sin favoritos</h3>
    <p>Guarda productos que te interesen para encontrarlos fácilmente.</p>
    <a href="{{ BASE }}/home" class="btn btn-primary">
      <i class="bi bi-search me-1"></i>Explorar productos
    </a>
  </div>
  {% else %}
  <div class="row g-3">
    {% for p in favoritos %}
    {% set imgSrc = p.imagen ? BASE ~ '/' ~ p.imagen : BASE ~ '/public/img/default.jpg' %}
    <div class="col-6 col-md-4 col-lg-3">
      <a href="{{ BASE }}/product/{{ p.id }}" class="text-decoration-none">
        <div class="product-card">
          <div style="position:relative;">
            <img src="{{ imgSrc|e }}" alt="{{ p.titulo|e }}"
                 style="width:100%;height:180px;object-fit:cover;"
                 onerror="this.onerror=null;this.src='{{ BASE }}/public/img/default.jpg'">
          </div>
          <div class="p-3">
            <div class="fw-semibold text-truncate" style="color:var(--c-text);">{{ p.titulo|e }}</div>
            <div class="fw-bold mt-1" style="color:var(--c-primary);">
              {% if p.tipo_transaccion == 'intercambio' %}
                <span class="badge bg-info text-dark" style="font-weight:500;"><i class="bi bi-arrow-left-right me-1"></i>Intercambio</span>
              {% elseif p.precio %}
                {{ p.precio|number_format(2) }} €
              {% else %}
                <span style="color:var(--c-muted);font-size:.85em;font-weight:400;">Precio no indicado</span>
              {% endif %}
            </div>
          </div>
        </div>
      </a>
    </div>
    {% endfor %}
  </div>
  {% endif %}

</div>
{% endblock %}
