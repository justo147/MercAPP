{% block scripts %}
{% for toast in chatToasts|default([]) %}
<script>document.addEventListener('DOMContentLoaded',()=>mostrarToast('{{ toast[1]|e('js') }}','{{ toast[0]|e('js') }}'));</script>
{% endfor %}
<script>
const CHAT_ID       = {{ chatId }};
const USUARIO_ACTUAL = {{ usuarioActual }};
</script>
<script>
(function () {
  const POLL_MS = 3000;

  function lastMsgId() {
    const nodes = document.querySelectorAll('#chat-box [data-id]');
    if (!nodes.length) return 0;
    return parseInt(nodes[nodes.length - 1].dataset.id, 10) || 0;
  }

  function isAtBottom(box) {
    return box.scrollHeight - box.scrollTop - box.clientHeight < 60;
  }

  function buildMsgHtml(msg) {
    if (msg.tipo === 'sistema') {
      return `<div class="msg-sistema" data-id="${msg.id}">
        <span class="bubble"><i class="bi bi-info-circle me-1"></i>${msg.contenido_clean}</span>
      </div>`;
    }
    const align  = msg.es_mio ? 'justify-content-end' : 'justify-content-start';
    const bubble = msg.es_mio ? 'bubble-out' : 'bubble-in';
    const nameEl = msg.es_mio ? `<div class="small mb-1 text-end" style="color:var(--c-muted);">${escHtml(msg.sender_name)} · ${escHtml(msg.fecha_envio)}</div>`
                               : `<div class="small mb-1" style="color:var(--c-muted);">${escHtml(msg.sender_name)} · ${escHtml(msg.fecha_envio)}</div>`;
    const status = msg.es_mio ? `<div class="small mt-1 text-end" style="color:var(--c-muted);">${msg.leido ? '✓✓ Leído' : '✓ Enviado'}</div>` : '';
    return `<div class="mb-2 d-flex ${align}" data-id="${msg.id}">
      <div style="max-width:80%;">
        ${nameEl}
        <div class="px-3 py-2 ${bubble}">${msg.contenido_html}</div>
        ${status}
      </div>
    </div>`;
  }

  function escHtml(str) {
    return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function poll(box) {
    if (document.hidden) return;
    const sinceId = lastMsgId();
    fetch(`${BASE}/api/chat_poll.php?chat_id=${CHAT_ID}&since_id=${sinceId}`)
      .then(r => r.ok ? r.json() : null)
      .then(data => {
        if (!data?.ok || !data.messages.length) return;
        const atBottom = isAtBottom(box);
        const empty = box.querySelector('.text-center.py-5');
        if (empty) empty.remove();
        data.messages.forEach(msg => {
          box.insertAdjacentHTML('beforeend', buildMsgHtml(msg));
        });
        if (atBottom) box.scrollTop = box.scrollHeight;
      })
      .catch(() => {});
  }

  document.addEventListener('DOMContentLoaded', () => {
    const box = document.getElementById('chat-box');
    if (!box) return;
    setInterval(() => poll(box), POLL_MS);
  });
})();
</script>

