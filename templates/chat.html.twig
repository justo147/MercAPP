<script src="{{ asset('js/address_autocomplete.js') }}"></script>
{% if stripeDisponible %}
<script src="https://js.stripe.com/v3/"></script>
{% endif %}

<script>
document.addEventListener('DOMContentLoaded', () => {

  // Auto-scroll chat to bottom on load
  const box = document.getElementById('chat-box');
  if (box) box.scrollTop = box.scrollHeight;

  // Send message via AJAX (avoids full page reload)
  const chatForm = document.querySelector('.chat-input-area form');
  const textarea = chatForm?.querySelector('textarea[name="mensaje"]');
  if (chatForm && textarea) {
    chatForm.addEventListener('submit', e => {
      e.preventDefault();
      const text = textarea.value.trim();
      if (!text) return;
      textarea.value = '';
      textarea.disabled = true;
      fetch(`${BASE}/public/views/chat.php?id=${CHAT_ID}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `mensaje=${encodeURIComponent(text)}`
      })
      .finally(() => { textarea.disabled = false; textarea.focus(); });
    });
  }

  // Address autocomplete
  if (typeof initAddressAutocomplete === 'function') {
    initAddressAutocomplete('direccion_envio', `${BASE}/api/normalize_address.php`);
  }

  // Report modal
  const radios = document.querySelectorAll('input[name="reporte_motivo_preset"]');
  const custom  = document.getElementById('motivo-custom');
  const final   = document.getElementById('reporte-motivo-final');
  const btnRep  = document.getElementById('btn-enviar-reporte');
  if (radios.length && custom && final && btnRep) {
    const syncReport = () => {
      const sel = document.querySelector('input[name="reporte_motivo_preset"]:checked');
      if (!sel) { btnRep.disabled = true; return; }
      if (sel.value === 'Otro') {
        const txt = custom.value.trim();
        final.value = txt || 'Otro';
        btnRep.disabled = txt === '';
        custom.disabled = false;
      } else {
        final.value = sel.value;
        btnRep.disabled = false;
        custom.disabled = true;
      }
    };
    radios.forEach(r => r.addEventListener('change', syncReport));
    custom.addEventListener('input', syncReport);
  }

  // Payment method option highlight
  document.querySelectorAll('.mp-option').forEach(label => {
    const radio = label.querySelector('input[type="radio"]');
    if (!radio) return;
    radio.addEventListener('change', () => {
      document.querySelectorAll('.mp-option').forEach(l => l.classList.remove('selected'));
      if (radio.checked) label.classList.add('selected');
    });
  });

  {% if esIntercambio and esComprador and transaccion and transaccion.estado == 'pendiente' %}
  // Exchange product loader
  const sel = document.getElementById('sel-producto-ofrecido');
  if (sel) {
    fetch(`${BASE}/api/mis_productos_activos.php`).then(r => r.json()).then(res => {
      const productos = res.data || [];
      if (!productos.length) {
        sel.innerHTML = '<option value="">No tienes productos activos para ofrecer</option>';
        return;
      }
      sel.innerHTML = '<option value="">— Selecciona un producto —</option>';
      productos.forEach(p => {
        const opt = document.createElement('option');
        opt.value = p.id;
        opt.textContent = p.titulo + (p.precio ? ' (' + parseFloat(p.precio).toFixed(2) + ' €)' : '');
        opt.dataset.imagen = p.imagen || '';
        sel.appendChild(opt);
      });
    }).catch(() => {
      sel.innerHTML = '<option value="">Error al cargar productos</option>';
    });

    sel.addEventListener('change', () => {
      const opt   = sel.options[sel.selectedIndex];
      const prev  = document.getElementById('preview-producto-ofrecido');
      const img   = document.getElementById('img-producto-ofrecido');
      const tit   = document.getElementById('titulo-producto-ofrecido');
      if (opt && opt.value && opt.dataset.imagen) {
        img.src = `${BASE}/${opt.dataset.imagen}`;
        tit.textContent = opt.textContent;
        prev.classList.remove('d-none');
      } else {
        prev.classList.add('d-none');
      }
    });
  }
  {% endif %}

  {% if stripeDisponible %}
  // Stripe Elements
  const stripeBlock = document.getElementById('stripe-payment-block');
  const errMsg      = document.getElementById('stripe-error-msg');
  const errTxt      = document.getElementById('stripe-error-text');
  const btnAceptar  = document.getElementById('btn-aceptar-transaccion');
  const btnTexto    = document.getElementById('btn-aceptar-texto');
  const btnIcon     = document.getElementById('btn-aceptar-icon');
  const piInput     = document.getElementById('stripe-pi-id');
  const formAceptar = document.getElementById('form-aceptar');

  if (stripeBlock && formAceptar && btnAceptar) {
    const STRIPE_PK      = '{{ stripeKey|e }}';
    const TRANSACCION_ID = {{ transaccion ? transaccion.id|default(0) : 0 }};
    const PRECIO         = {{ importeStripe|default(0) }};

    const stripe      = Stripe(STRIPE_PK);
    const elements    = stripe.elements();
    const cardElement = elements.create('card', {
      style: {
        base: {
          fontFamily: 'system-ui, sans-serif',
          fontSize: '15px',
          color: document.documentElement.getAttribute('data-theme') === 'dark' ? '#e0e0e0' : '#212529',
          '::placeholder': { color: '#adb5bd' }
        },
        invalid: { color: '#dc3545' }
      },
      hidePostalCode: true
    });
    cardElement.mount('#stripe-card-element');
    cardElement.on('change', e => {
      if (e.error) { errTxt.textContent = e.error.message; errMsg.classList.remove('d-none'); }
      else { errMsg.classList.add('d-none'); }
    });

    const mpStripeRadio = document.getElementById('mp-stripe');
    if (mpStripeRadio) {
      document.querySelectorAll('input[name="metodo_pago"]').forEach(radio => {
        radio.addEventListener('change', () => {
          if (radio.value === 'stripe' && radio.checked) {
            stripeBlock.style.display = 'block';
            btnTexto.textContent = `Pagar ${PRECIO.toFixed(2).replace('.', ',')} € con tarjeta`;
            btnIcon.className = 'bi bi-lock-fill me-1';
            btnAceptar.classList.replace('btn-success', 'btn-primary');
          } else if (radio.checked) {
            stripeBlock.style.display = 'none';
            btnTexto.textContent = '{{ esIntercambio ? 'Proponer intercambio' : 'Aceptar y confirmar' }}';
            btnIcon.className = 'bi bi-hand-thumbs-up me-1';
            btnAceptar.classList.replace('btn-primary', 'btn-success');
          }
        });
      });
    }

    formAceptar.addEventListener('submit', async e => {
      if (!mpStripeRadio || !mpStripeRadio.checked) return;
      e.preventDefault();
      btnAceptar.disabled = true;
      btnTexto.textContent = 'Procesando pago…';
      btnIcon.className = 'spinner-border spinner-border-sm me-1';
      errMsg.classList.add('d-none');
      try {
        const resp = await fetch(`${BASE}/api/stripe_create_payment.php`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: `transaccion_id=${TRANSACCION_ID}`
        });
        if (!resp.ok) {
          const err = await resp.json().catch(() => ({}));
          throw new Error(err.error || 'Error al iniciar el pago');
        }
        const { client_secret } = await resp.json();
        const { paymentIntent, error } = await stripe.confirmCardPayment(client_secret, {
          payment_method: { card: cardElement }
        });
        if (error) throw new Error(error.message);
        if (paymentIntent.status !== 'succeeded') throw new Error('El pago no pudo completarse.');
        piInput.value = paymentIntent.id;
        formAceptar.submit();
      } catch (err) {
        errTxt.textContent = err.message;
        errMsg.classList.remove('d-none');
        btnAceptar.disabled = false;
        btnTexto.textContent = `Pagar ${PRECIO.toFixed(2).replace('.', ',')} € con tarjeta`;
        btnIcon.className = 'bi bi-lock-fill me-1';
      }
    });
  }
  {% endif %}

  // Show rating modal automatically if needed
  {% if mostrarModalValoracion %}
  const modalVal = document.getElementById('modalValoracion');
  if (modalVal) {
    setTimeout(() => {
      const m = bootstrap.Modal.getOrCreateInstance(modalVal);
      m.show();
    }, 800);
  }
  {% endif %}
});
</script>
{% endblock %}
